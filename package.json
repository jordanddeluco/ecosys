{
  "name": "ecosys",
  "version": "0.3.0",
  "private": true,
  "description": "A small ecosystem of personal apps that work together: tasks, schedule and notes, with optional AI access over MCP.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs --open",
    "serve": "node server.mjs",
    "mcp": "node mcp/stdio-bridge.mjs",
    "test": "node --test tests/*.test.js",
    "test:server": "node --test tests/server-*.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
